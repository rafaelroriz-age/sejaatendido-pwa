# Frontend public URLs
NEXT_PUBLIC_FRONTEND_URL=https://sejaatendido.com
NEXT_PUBLIC_API_URL=https://sejaatendido-backend.onrender.com

# Vite runtime variables (primary)
VITE_API_URL=https://sejaatendido-backend.onrender.com
VITE_FRONTEND_URL=https://sejaatendido.com

# Real backend integration: keep false unless you intentionally run MSW
VITE_MOCK=false

# Asaas — tokenizacao de cartao client-side (numero/CVV nunca passam pelo backend).
# Use a CHAVE RESTRITA DE TOKENIZACAO do Asaas (nunca a chave de API secreta da conta).
# Sem esta chave, o checkout de cartao fica bloqueado com mensagem tratada na UI.
VITE_ASAAS_TOKENIZATION_KEY=
# "sandbox" (padrao fora de producao) ou "production"
VITE_ASAAS_ENV=sandbox

# Integrations
VITE_GOOGLE_CLIENT_ID=
VITE_VAPID_PUBLIC_KEY=
